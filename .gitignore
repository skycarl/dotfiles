# macOS cruft
.DS_Store
.AppleDouble
.LSOverride
._*

# Secrets and machine-local config — never commit these.
# Secret *values* belong in 1Password; keep machine-specific settings in
# ~/.local_config, which .zshrc sources but this repo does not track.
.env
.env.*
!.env.example
.local_config
.secrets
secrets.*
*.secret

# Credentials, keys, certificates
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_*
!id_*.pub
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
known_hosts
authorized_keys

# Cloud / tooling credential stores
.aws/
.netrc
.npmrc
.pypirc
.docker/config.json
*.kubeconfig
kubeconfig
gcloud-*.json
service-account*.json

# Shell history (may contain pasted secrets)
.zsh_history
.bash_history
.python_history
.node_repl_history
.lesshst

# Editor/temp files that can hold buffered secrets
*.swp
*.swo
*~
.idea/
.vscode/
